# Local development values. There are no real secrets here.
# Copy to .env to run outside Docker: cp .env.example .env

PORT=3000
DATABASE_URL=postgres://invoices:invoices@localhost:5432/invoices
DATABASE_URL_TEST=postgres://invoices:invoices@localhost:5432/invoices_test

# Runs the outbox relay and the inbound consumer inside the API process.
WORKERS_ENABLED=true
# Runs a fake provider inside the process, to demo the full flow. Off in production.
SIMULATE_PROVIDER=false

POLL_INTERVAL_MS=500
QUEUE_MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
